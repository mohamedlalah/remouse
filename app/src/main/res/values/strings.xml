    <string name="app_name">Remouse Multilingual</string>
    <string name="accessibility_description">Remouse Multilingual turns your remote’s direction buttons into a freely movable on-screen cursor. Press OK to click. Once enabled, you can move the cursor and click on any screen.</string>
